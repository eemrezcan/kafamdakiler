@using Kafamdakiler.Aliskanliklar
@model Kafamdakiler.Pages.Aliskanliklar.IndexModel.Kart
@{
    var a = Model.Aliskanlik;
    var (oran, durum) = Gorunum.Ilerleme(a);
    var adim = Gorunum.Adim(a);
    var yapildi = a.Bugun.Miktar > 0;
    // More items than this: the rest are reached from the shelf page.
    const int EnCokKapak = 5;
}
<article class="kd-habit @Gorunum.RenkSinifi(a.Renk)" id="h-@a.Id">
    <header class="kd-habit-head">
        <span class="kd-habit-icon" aria-hidden="true">
            <svg class="kd-icon"><use href="/img/icons.svg#@Gorunum.Ikon(a.Ikon)"></use></svg>
        </span>
        <div class="kd-habit-id">
            <h2 class="kd-habit-name"><a asp-page="Detay" asp-route-id="@a.Id">@a.Ad</a></h2>
            <p class="kd-habit-meta">@Gorunum.SiklikMetni(a) · <span title="Düzenin: yaptığın her gün artar, kaçırınca biraz düşer; tek kaçırma sıfırlamaz.">Güç @Gorunum.Yuzde(a.Guc)</span>@(a.Seri > 0 ? $" · Seri {a.Seri}" : "")</p>
        </div>
        <a class="kd-icon-btn" asp-page="Duzenle" asp-route-id="@a.Id" aria-label="@a.Ad alışkanlığını düzenle">
            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-pencil"></use></svg>
        </a>
    </header>

    <div class="kd-habit-progress">
        <div class="kd-bar @(durum != "" ? "is-" + durum : "")" role="progressbar" aria-label="Bugünkü ilerleme"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(oran * 100)">
            <span style="width:@Gorunum.Genislik(oran)"></span>
        </div>
        <p class="kd-readout">@Gorunum.BugunMetni(a)</p>
    </div>

    @if (a.Tur == AliskanlikTuru.Raf)
    {
        @if (a.DevamEdenler.Count == 0)
        {
            <div class="kd-habit-actions kd-habit-empty">
                <p>Devam eden @((a.OgeEtiketi ?? "öğe").ToLower(new System.Globalization.CultureInfo("tr-TR"))) yok.</p>
                <a class="btn btn-outline-primary" asp-page="OgeDuzenle" asp-route-aliskanlikId="@a.Id">+ @a.OgeEtiketi</a>
            </div>
        }
        @if (a.DevamEdenler.Count == 1)
        {
            var o = a.DevamEdenler[0];
            <div class="kd-shelf">
                <a class="kd-cover-link" asp-page="Oge" asp-route-id="@o.Id" tabindex="-1" aria-hidden="true">
                    <partial name="_Kapak" model="(o.FotografUrl, a.Ikon)" />
                </a>
                <partial name="_DevamEden" model="(a, o)" />
            </div>
        }
        else if (a.DevamEdenler.Count > 1)
        {
            @* Several items in progress: covers act as tabs (hidden radios), the chosen one's panel shows below.
               The first item is the most recently read, so it opens selected; CSS does the switching, no JS. *@
            var gorunen = a.DevamEdenler.Take(EnCokKapak).ToList();
            var kalan = a.DevamEdenler.Count - gorunen.Count;
            <div class="kd-shelf-pick">
                <div class="kd-shelf-pick-tabs" role="radiogroup" aria-label="Devam edenler: @a.Ad">
                    @for (var i = 0; i < gorunen.Count; i++)
                    {
                        var o = gorunen[i];
                        <label class="kd-shelf-pick-tab" title="@o.Ad">
                            <input class="visually-hidden" type="radio" name="sec-@a.Id" value="@o.Id" checked="@(i == 0)" autocomplete="off" />
                            <partial name="_Kapak" model="(o.FotografUrl, a.Ikon)" />
                            <span class="visually-hidden">@o.Ad</span>
                        </label>
                    }
                    @if (kalan > 0)
                    {
                        <a class="kd-shelf-pick-more" asp-page="Raf" asp-route-aliskanlikId="@a.Id" aria-label="@kalan tane daha, rafa git">+@kalan</a>
                    }
                </div>
                <div class="kd-shelf-pick-panels">
                    @foreach (var o in gorunen)
                    {
                        <div class="kd-shelf-pick-panel">
                            <partial name="_DevamEden" model="(a, o)" />
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (a.Olcu == Olcu.EvetHayir)
    {
        <form method="post" asp-page-handler="Tik" asp-route-id="@a.Id" class="kd-habit-actions">
            <button type="submit" class="kd-tick @(yapildi ? "is-done" : "")" aria-pressed="@(yapildi ? "true" : "false")">
                <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-check"></use></svg>
                <span>@(yapildi ? "Yapıldı · geri al" : "Yaptım")</span>
            </button>
        </form>
    }
    else
    {
        <div class="kd-habit-actions kd-stepper">
            <form method="post" asp-page-handler="Sayi" asp-route-id="@a.Id">
                <input type="hidden" name="delta" value="@Gorunum.Girdi(-adim)" />
                <button type="submit" class="kd-step-btn" aria-label="@Gorunum.Sayi(adim) @a.Birim azalt">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-minus"></use></svg>
                </button>
            </form>
            <form method="post" asp-page-handler="Ayarla" asp-route-id="@a.Id" class="kd-stepper-set">
                <label class="visually-hidden" for="m-@a.Id">Bugünkü miktar (@a.Birim)</label>
                <input id="m-@a.Id" name="miktar" type="number" step="any" min="0" inputmode="decimal" enterkeyhint="done" class="form-control"
                       value="@Gorunum.Girdi(a.Bugun.Miktar)" />
                @* −/+ save on their own; this small check saves a typed number (Enter does too). *@
                <button type="submit" class="kd-stepper-save" aria-label="Yazdığın miktarı kaydet">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-check"></use></svg>
                </button>
            </form>
            <form method="post" asp-page-handler="Sayi" asp-route-id="@a.Id">
                <input type="hidden" name="delta" value="@Gorunum.Girdi(adim)" />
                <button type="submit" class="kd-step-btn kd-step-btn--add" aria-label="@Gorunum.Sayi(adim) @a.Birim artır">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-plus"></use></svg>
                </button>
            </form>
        </div>
    }

    <footer class="kd-strip" aria-label="Son 7 gün">
        @foreach (var gun in Model.SonGunler)
        {
            <span class="kd-strip-day @(gun.Tarih == a.Bugun.Tarih ? "is-today" : "")"
                  title="@Gorunum.GunAy(gun.Tarih): @Gorunum.Sayi(gun.Miktar)@(a.Birim is null ? "" : " " + a.Birim)">
                <i class="kd-dot is-@Gorunum.GunDurumu(gun, a.Olusturulma)"></i>
                <small>@Gorunum.GunKisa(gun.Tarih)</small>
            </span>
        }
    </footer>
</article>
