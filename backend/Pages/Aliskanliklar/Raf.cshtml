@page "{aliskanlikId:guid}"
@using Kafamdakiler.Aliskanliklar
@model Kafamdakiler.Pages.Aliskanliklar.RafModel
@{
    var a = Model.Aliskanlik;
    var etiket = a.OgeEtiketi ?? "Öğe";
    ViewData["Title"] = a.Ad + " rafı";
    var bos = Model.Raflar.All(r => r.Ogeler.Count == 0);
}

<div class="kd-page-head kd-rise @Gorunum.RenkSinifi(a.Renk)">
    <div>
        <p class="kd-eyebrow"><a class="kd-back" asp-page="Detay" asp-route-id="@a.Id"><svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-chevron-left"></use></svg>@a.Ad</a></p>
        <h1 class="kd-page-title">Raf</h1>
    </div>
    <a class="btn btn-primary kd-btn-add" asp-page="OgeDuzenle" asp-route-aliskanlikId="@a.Id">
        <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-plus"></use></svg>
        @etiket ekle
    </a>
</div>

@if (bos)
{
    <div class="kd-empty">
        <p class="kd-empty-title">Raf boş.</p>
        <p>İlk @etiket.ToLower(new System.Globalization.CultureInfo("tr-TR")) ekle, nereye kadar geldiğini panelden tek alanla girersin.</p>
        <a class="btn btn-primary" asp-page="OgeDuzenle" asp-route-aliskanlikId="@a.Id">+ @etiket</a>
    </div>
}
else
{
    @foreach (var (durum, ogeler) in Model.Raflar)
    {
        if (ogeler.Count == 0)
        {
            continue;
        }

        <section class="kd-shelf-section @Gorunum.RenkSinifi(a.Renk)" aria-labelledby="raf-@durum">
            <h2 class="kd-eyebrow" id="raf-@durum">@Gorunum.DurumAdi(durum) · @ogeler.Count</h2>
            <div class="kd-covers">
                @foreach (var o in ogeler)
                {
                    <a class="kd-book" asp-page="Oge" asp-route-id="@o.Id">
                        @if (o.FotografUrl is not null)
                        {
                            <img class="kd-cover" src="@o.FotografUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="kd-cover kd-cover--empty"><svg class="kd-icon"><use href="/img/icons.svg#@Gorunum.Ikon(a.Ikon)"></use></svg></span>
                        }
                        <span class="kd-book-title">@o.Ad</span>
                        @if (!string.IsNullOrEmpty(o.AltBaslik))
                        {
                            <span class="kd-muted">@o.AltBaslik</span>
                        }
                        @if (durum == OgeDurumu.Devam && o.Ilerleme is { } ilerleme)
                        {
                            <span class="kd-bar kd-bar--thin"><span style="width:@Gorunum.Genislik(ilerleme)"></span></span>
                        }
                        @if (durum == OgeDurumu.Bitti && o.Puan is { } puan)
                        {
                            <span class="kd-muted">@puan / 5</span>
                        }
                    </a>
                }
            </div>
        </section>
    }

    @if (Model.YilOzeti.Count > 0)
    {
        <section class="kd-panel" aria-labelledby="kd-year-title">
            <h2 class="kd-eyebrow" id="kd-year-title">Yıl özeti</h2>
            <table class="kd-table">
                <thead><tr><th>Yıl</th><th>Biten @etiket.ToLower(new System.Globalization.CultureInfo("tr-TR"))</th><th>Toplam @a.Birim</th></tr></thead>
                <tbody>
                    @foreach (var (yil, adet, miktar) in Model.YilOzeti)
                    {
                        <tr><td>@yil</td><td>@adet</td><td>@Gorunum.Sayi(miktar)</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
