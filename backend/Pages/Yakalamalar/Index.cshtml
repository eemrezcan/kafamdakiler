@page
@using Kafamdakiler.Yakalamalar
@model Kafamdakiler.Pages.Yakalamalar.IndexModel
@{
    ViewData["Title"] = "Yakalamalar";
    var bugun = YakalamaGorunum.Bugun();
}

<div class="kd-page-head kd-rise kd-c-violet">
    <div>
        <p class="kd-eyebrow">Aklına geleni topla</p>
        <h1 class="kd-page-title">Yakalamalar</h1>
    </div>
</div>

@* Quick capture: posts to the edit page's handler, so the rules and the photo handling live in one place. *@
<form method="post" asp-page="Duzenle" enctype="multipart/form-data" class="kd-composer kd-c-violet" data-kd-composer>
    <input type="hidden" name="Input.YakalandiAt" value="@DateTimeOffset.UtcNow.ToString("o")" data-kd-composer-now />
    <label class="visually-hidden" for="kd-composer-metin">Aklında ne var?</label>
    <textarea class="kd-composer-input" id="kd-composer-metin" name="Input.Metin" rows="2" maxlength="5000"
              placeholder="Aklında ne var?" autofocus data-kd-composer-metin></textarea>

    <div class="kd-composer-preview" hidden data-kd-composer-preview>
        <img alt="Seçilen fotoğraf" />
        <button type="button" class="kd-composer-remove" aria-label="Fotoğrafı çıkar" data-kd-composer-remove>
            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-x"></use></svg>
        </button>
    </div>

    <div class="kd-composer-bar">
        <label class="kd-icon-btn kd-composer-photo" title="Fotoğraf ekle">
            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-image-plus"></use></svg>
            <span class="visually-hidden">Fotoğraf ekle</span>
            <input class="visually-hidden" type="file" name="Fotograf" accept="image/jpeg,image/png,image/webp" data-kd-composer-file />
        </label>
        <a class="kd-composer-more" asp-page="Duzenle">Hedefle ekle</a>
        <span class="kd-composer-hint" aria-hidden="true"><kbd>Ctrl</kbd> + <kbd>Enter</kbd></span>
        <button type="submit" class="btn btn-primary kd-composer-save" disabled data-kd-composer-save>Kaydet</button>
    </div>
</form>

@if (Model.Hata is not null)
{
    <div class="kd-alert" role="alert">@Model.Hata</div>
}

@if (Model.Toplam > 0)
{
    <nav class="kd-filter" aria-label="Duruma göre süz">
        <a class="kd-filter-chip @(Model.Durum is null ? "is-active" : "")" asp-page="Index"
           aria-current="@(Model.Durum is null ? "page" : null)">Hepsi <span>@Model.Toplam</span></a>
        @foreach (var durum in Enum.GetValues<YakalamaDurumu>())
        {
            var sayi = Model.Sayilar.GetValueOrDefault(durum);
            <a class="kd-filter-chip @(Model.Durum == durum ? "is-active" : "")" asp-page="Index" asp-route-durum="@durum"
               aria-current="@(Model.Durum == durum ? "page" : null)">@YakalamaGorunum.DurumAdi(durum) <span>@sayi</span></a>
        }
    </nav>
}

@if (Model.Yakalamalar.Count == 0)
{
    <div class="kd-empty kd-empty--small">
        <p class="kd-empty-title">@(Model.Durum is null ? "Henüz yakalama yok." : "Bu durumda yakalama yok.")</p>
        @if (Model.Durum is null)
        {
            <p class="mb-0">Aklına gelen bir şeyi yukarıya yaz ya da fotoğrafını ekle; düzene sokmayı sonraya bırak.</p>
        }
    </div>
}
else
{
    @foreach (var gun in Model.Yakalamalar.GroupBy(y => YakalamaGorunum.Gun(y.YakalandiAt)))
    {
        <section class="kd-capture-day" aria-labelledby="gun-@gun.Key.ToString("yyyy-MM-dd")">
            <h2 class="kd-capture-day-title" id="gun-@gun.Key.ToString("yyyy-MM-dd")">@YakalamaGorunum.GunBasligi(gun.Key, bugun)</h2>

            @foreach (var y in gun)
            {
                <article class="kd-capture kd-c-violet" id="y-@y.Id">
                    @if (y.FotografUrl is not null)
                    {
                        <a class="kd-capture-photo" href="@y.FotografUrl" target="_blank" rel="noopener" aria-label="Fotoğrafı büyük aç">
                            <img src="@y.FotografUrl" alt="" loading="lazy" />
                        </a>
                    }
                    <div class="kd-capture-body">
                        @if (!string.IsNullOrEmpty(y.Metin))
                        {
                            <p class="kd-capture-text">@y.Metin</p>
                        }
                        else
                        {
                            <p class="kd-capture-text is-empty">Fotoğraf</p>
                        }
                        <p class="kd-capture-meta">
                            <time datetime="@y.YakalandiAt.ToString("o")" title="@YakalamaGorunum.Zaman(y.YakalandiAt)">@YakalamaGorunum.Saat(y.YakalandiAt)</time>
                            @if (y.Hedef is not null)
                            {
                                <span class="kd-capture-target" title="@y.Hedef">
                                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-folder"></use></svg>@YakalamaGorunum.HedefAdi(y.Hedef)
                                </span>
                            }
                            @* Waiting is the normal state, so only the later states get a badge. *@
                            @if (y.Durum != YakalamaDurumu.Bekliyor)
                            {
                                <span class="kd-status is-@y.Durum.ToString().ToLowerInvariant()">@YakalamaGorunum.DurumAdi(y.Durum)</span>
                            }
                        </p>
                    </div>
                    @if (y.Durum == YakalamaDurumu.Bekliyor)
                    {
                        <a class="kd-icon-btn kd-capture-edit" asp-page="Duzenle" asp-route-id="@y.Id" aria-label="Yakalamayı düzenle">
                            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-pencil"></use></svg>
                        </a>
                    }
                </article>
            }
        </section>
    }
}

@section Scripts {
    <script src="~/js/yakalamalar.js" asp-append-version="true"></script>
}
