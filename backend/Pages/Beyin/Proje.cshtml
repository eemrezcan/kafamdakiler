@page "{kimlik}"
@using Kafamdakiler.Beyin
@model Kafamdakiler.Pages.Beyin.ProjeModel
@{
    ViewData["Title"] = Model.Proje?.Baslik ?? "Proje";
}

<div class="kd-page-head kd-rise kd-c-violet">
    <div>
        <p class="kd-eyebrow">Proje</p>
        <h1 class="kd-page-title">@(Model.Proje?.Baslik ?? "Proje")</h1>
    </div>
</div>

<partial name="_BeyinMenu" />
<partial name="_BeyinHata" model="Model" />

@if (Model.Proje is { } proje)
{
    <section class="kd-yonetim-blok" aria-labelledby="durum-baslik">
        <h2 class="kd-eyebrow kd-section-title" id="durum-baslik">Durum</h2>
        <p class="kd-beyin-metin @(proje.Durum is null ? "kd-muted" : "")">@(proje.Durum ?? "Durum yazılmamış.")</p>
    </section>

    <section class="kd-yonetim-blok" aria-labelledby="adim-baslik">
        <h2 class="kd-eyebrow kd-section-title" id="adim-baslik">Sıradaki adım</h2>
        <p class="kd-beyin-metin @(proje.SiradakiAdim is null ? "kd-muted" : "")">@(proje.SiradakiAdim ?? "Sıradaki adım yazılmamış.")</p>
    </section>

    <section class="kd-yonetim-blok" aria-labelledby="gorev-baslik">
        <h2 class="kd-eyebrow kd-section-title" id="gorev-baslik">Açık görevler</h2>
        @if (proje.AcikGorevler.Count == 0)
        {
            <p class="kd-muted">Açık görev yok.</p>
        }
        @foreach (var g in proje.AcikGorevler)
        {
            var bilgi = string.Join(" · ", new[]
            {
                BeyinGorunum.GorevDurumu(g.Durum),
                g.Bitis is { } bitis ? $"Bitiş {BeyinGorunum.KisaTarih(bitis)}" : "",
                BeyinGorunum.Oncelik(g.Oncelik),
            }.Where(s => s.Length > 0));
            <article class="kd-capture kd-c-violet">
                <div class="kd-capture-body">
                    <p class="kd-capture-text mb-1">@g.Baslik</p>
                    @if (bilgi.Length > 0)
                    {
                        <p class="kd-capture-meta"><span>@bilgi</span></p>
                    }
                    @if (g.SonrakiAdim is not null)
                    {
                        <p class="kd-capture-meta mt-1"><span>→ @g.SonrakiAdim</span></p>
                    }
                </div>
            </article>
        }
    </section>

    <section class="kd-yonetim-blok" aria-labelledby="gunluk-baslik">
        <h2 class="kd-eyebrow kd-section-title" id="gunluk-baslik">Son günlük</h2>
        @if (proje.SonGunluk.Count == 0)
        {
            <p class="kd-muted">Günlük satırı yok.</p>
        }
        @foreach (var s in proje.SonGunluk)
        {
            <article class="kd-capture kd-c-violet">
                <div class="kd-capture-body">
                    @if (s.Zaman is not null)
                    {
                        <p class="kd-capture-meta mb-1"><span>@s.Zaman</span></p>
                    }
                    @if (s.Baslik is not null)
                    {
                        <p class="kd-capture-text mb-1">@s.Baslik</p>
                    }
                    @if (!string.IsNullOrEmpty(s.Metin))
                    {
                        <p class="kd-capture-text mb-0">@s.Metin</p>
                    }
                </div>
            </article>
        }
    </section>
}
