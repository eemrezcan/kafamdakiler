@* Only date-shaped addresses match, so a mistyped address stays a 404 instead of an "invalid date" page. *@
@page "{tarih:regex(^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$)?}"
@using System.Globalization
@using Kafamdakiler.Aliskanliklar
@using Kafamdakiler.Beyin
@using Kafamdakiler.Yapilacaklar
@model Kafamdakiler.Pages.IndexModel
@{
    ViewData["Title"] = Model.BugunSayfasi ? "Bugün" : "Gün planı";
    var tarih = Model.Tarih;
    var t = tarih.ToString("yyyy-MM-dd");
    var gorunum = Model.Gorunum;
    var donus = Model.BugunSayfasi ? "/" : $"/{t}";
    var projeAdlari = Model.Projeler.ToDictionary(p => p.Kimlik, p => p.Baslik);
}

<div class="kd-page-head kd-rise kd-c-violet">
    <div>
        <p class="kd-eyebrow">@(Model.BugunSayfasi ? "Bugün" : "Gün planı")</p>
        <h1 class="kd-page-title">@BeyinGorunum.GunBasligi(tarih)</h1>
    </div>

    @* Day by day, or straight to a date: one row. The calendar button opens the date picker and picking a date goes there (bugun.js);
       the hidden "Git" button keeps it working without JavaScript. The page works from the address (/2026-11-03) as well. *@
    <nav class="kd-gun-nav" aria-label="Gün gezinmesi">
        <a class="kd-icon-btn" asp-page="/Index" asp-route-tarih="@tarih.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Önceki gün" title="Önceki gün">
            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-chevron-left"></use></svg>
        </a>
        <span class="kd-gun-nav-etiket">@tarih.ToString("d MMMM ddd", new CultureInfo("tr-TR"))</span>
        <a class="kd-icon-btn" asp-page="/Index" asp-route-tarih="@tarih.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Sonraki gün" title="Sonraki gün">
            <svg class="kd-icon kd-icon--sag" aria-hidden="true"><use href="/img/icons.svg#lucide-chevron-left"></use></svg>
        </a>
        <form method="get" asp-page="/Index" class="kd-gun-nav-tarih">
            <label class="visually-hidden" for="beyin-tarih">Tarih</label>
            <input class="kd-gun-nav-girdi" type="date" id="beyin-tarih" name="tarih" value="@t" data-kd-tarih />
            <button type="button" class="kd-icon-btn" aria-label="Tarih seç" title="Tarih seç" data-kd-tarih-ac>
                <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-calendar"></use></svg>
            </button>
            <button type="submit" class="visually-hidden">Git</button>
        </form>
        @if (tarih != Model.Bugun)
        {
            <a class="kd-filter-chip" asp-page="/Index">Bugüne dön</a>
        }
    </nav>
</div>

@if (Model.YazmaHatasi is not null)
{
    <div class="kd-alert" role="alert">@Model.YazmaHatasi</div>
}

@if (Model.TarihHatasi is { } tarihHatasi)
{
    <div class="kd-empty kd-empty--small" role="status">
        <p class="kd-empty-title">Geçersiz tarih</p>
        <p class="mb-0">@tarihHatasi</p>
    </div>
}
else if (gorunum is null)
{
    <div class="kd-empty kd-empty--small" role="status">
        <p class="kd-empty-title">Gün şu an hazırlanamadı.</p>
        <p class="mb-0">Biraz sonra tekrar dene.</p>
    </div>
}
else
{
    var yuk = gorunum.Yuk;
    var yazilabilir = Model.Yazilabilir;
    var acikSayisi = gorunum.Ogeler.Count(o => o.Durum == YapilacakDurumu.Acik);
    // Events cannot be "done", so they stay out of the "x / y tamam" count.
    var isSayisi = gorunum.Ogeler.Count(o => o.Tur != YapilacakTuru.Etkinlik);
    var isYapilan = gorunum.Ogeler.Count(o => o.Tur != YapilacakTuru.Etkinlik && o.Durum == YapilacakDurumu.Yapildi);
    var toplamDk = yuk.AcikTahminDk + yuk.EtkinlikDk;
    var doluluk = Math.Min(100, (int)Math.Round(100.0 * toplamDk / Math.Max(1, yuk.KapasiteDk)));

    @* Two columns from 992px (main: leftovers, the list, the new-item form; side: summary and weight, the habit strip); one column below, where
       `order` puts the summary first, the leftovers and the habit strip next, the list last. The wrappers vanish (display: contents) on a phone so their children can be ordered together. *@
    <div class="kd-bugun">
        <div class="kd-bugun-ana">
            @if (gorunum.DundenKalanlar.Count > 0)
            {
                <section class="kd-blok kd-bugun-kalan" aria-labelledby="sabah-baslik">
                    <h2 class="kd-eyebrow kd-section-title" id="sabah-baslik">Dünden kalanlar <span>@gorunum.DundenKalanlar.Count</span></h2>
                    <p class="kd-muted">Dün bitmeyenler. <strong>Taşı</strong> bugüne alır, <strong>Bırak</strong> yalnız bu listeden çıkarır.</p>
                    @foreach (var madde in gorunum.DundenKalanlar)
                    {
                        <article class="kd-satir kd-c-violet">
                            <div class="kd-satir-govde">
                                <p class="kd-satir-baslik">@madde.Baslik</p>
                                <div class="kd-satir-meta">
                                    @if (madde.Proje is not null)
                                    {
                                        <span>@Model.ProjeAdi(madde.Proje)</span>
                                    }
                                    @if (madde.TahminDk is { } dk)
                                    {
                                        <span>@BeyinGorunum.Dakika(dk)</span>
                                    }
                                </div>
                            </div>
                            <div class="kd-gun-actions">
                                <form method="post" asp-page-handler="SabahTasi" asp-route-tarih="@t">
                                    <input type="hidden" name="madde" value="@madde.MaddeId" />
                                    <button type="submit" class="btn btn-primary btn-sm">Taşı</button>
                                </form>
                                <form method="post" asp-page-handler="SabahBirak" asp-route-tarih="@t">
                                    <input type="hidden" name="madde" value="@madde.MaddeId" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Bırak</button>
                                </form>
                            </div>
                        </article>
                    }
                </section>
            }

            <div class="kd-bugun-plan">
                @if (Model.PlanUyarisi is { } uyari)
                {
                    <div class="kd-gun-uyari" role="status">@uyari</div>
                }

                @if (Kafamdakiler.Pages.GunMetinleri.GoogleNotu(gorunum.Kaynaklar.Google) is { } googleNotu)
                {
                    <p class="kd-muted">@googleNotu <a asp-page="/Yonetim/Index">Yönetim</a></p>
                }

                @if (gorunum.Kapandi)
                {
                    <p class="kd-muted">Bu gün kapandı; kapanmış güne yazılmaz.</p>
                }

                <section class="kd-blok" aria-labelledby="liste-baslik">
                    <h2 class="kd-eyebrow kd-section-title" id="liste-baslik">
                        Yapılacaklar <span>@acikSayisi</span>
                    </h2>
                    @if (gorunum.Ogeler.Count == 0)
                    {
                        <div class="kd-empty kd-empty--small">
                            <p class="kd-empty-title">Bu gün için bir şey yok.</p>
                        </div>
                    }
                    @foreach (var oge in gorunum.Ogeler)
                    {
                        <partial name="_GunSatiri" model="new GunSatiriModeli(oge, tarih, donus, yazilabilir, projeAdlari)" />
                    }
                    @if (isSayisi > 0)
                    {
                        <p class="kd-muted">@isYapilan / @isSayisi tamam</p>
                    }
                </section>

                @if (yazilabilir)
                {
                    <details class="kd-blok kd-yeni-kutu">
                        <summary class="kd-eyebrow kd-section-title">+ Yeni yapılacak</summary>
                        <partial name="_YeniOge" model="new YeniOgeModeli(tarih, donus)" />
                    </details>
                }
            </div>
        </div>

        <div class="kd-bugun-yan">
            <section class="kd-blok kd-bugun-ozet" aria-labelledby="ozet-baslik">
                <h2 class="kd-eyebrow kd-section-title" id="ozet-baslik">@(Model.BugunSayfasi ? "Asistanın özeti" : "Günün yükü")</h2>
                @if (gorunum.Ozet is { } ozet)
                {
                    <p class="kd-ozet-metin">@ozet</p>
                }

                <div class="kd-yuk" role="group" aria-label="Gün yükü">
                    <div class="kd-yuk-ust">
                        <span>@BeyinGorunum.Dakika(toplamDk) <span class="kd-muted">/ @BeyinGorunum.Dakika(yuk.KapasiteDk)</span></span>
                        <span class="kd-muted">kapasite</span>
                    </div>
                    <div class="kd-yuk-cubuk @(yuk.AsimDk > 0 ? "is-asim" : "")" role="img"
                         aria-label="Açık işler ve etkinlikler günün kapasitesinin yüzde @doluluk kadarı">
                        <span style="width:@doluluk%"></span>
                    </div>
                    @if (yuk.AsimDk > 0)
                    {
                        <p class="kd-yuk-not is-asim">Gün @BeyinGorunum.Dakika(yuk.AsimDk) taşıyor. Bir kısmını devret (satırın ayrıntısında).</p>
                    }
                    else if (toplamDk > 0 && yuk.BosDk > 0)
                    {
                        <p class="kd-yuk-not">@BeyinGorunum.Dakika(yuk.BosDk) boşluk var.</p>
                    }
                    @if (yuk.EtkinlikDk > 0)
                    {
                        <p class="kd-yuk-not kd-muted">Etkinlikler @BeyinGorunum.Dakika(yuk.EtkinlikDk), açık işler @BeyinGorunum.Dakika(yuk.AcikTahminDk).</p>
                    }
                    @if (yuk.TahminsizSayi > 0)
                    {
                        <p class="kd-yuk-not kd-muted">@yuk.TahminsizSayi işin süre tahmini yok; yük bunları saymaz.</p>
                    }
                </div>
            </section>

            @if (Model.BugunSayfasi)
            {
                <section class="kd-blok kd-bugun-aliskanlik" aria-labelledby="aliskanlik-baslik">
                    <h2 class="kd-eyebrow kd-section-title" id="aliskanlik-baslik">Bugünün alışkanlıkları @if (Model.BugunkuAliskanliklar.Count > 0) { <span>@Model.BugunkuAliskanliklar.Count</span> }</h2>
                    @if (Model.BugunkuAliskanliklar.Count > 0)
                    {
                        <partial name="_AliskanlikSeridi" model="Model.BugunkuAliskanliklar" />
                        <p class="kd-footnote"><a asp-page="/Aliskanliklar/Index">Tüm alışkanlıklar</a></p>
                    }
                    else
                    {
                        <div class="kd-bos-kart">
                            <span>Bugün için alışkanlık yok</span>
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Aliskanliklar/Duzenle" asp-route-tur="Sayac">+ Alışkanlık ekle</a>
                        </div>
                    }
                </section>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/bugun.js" asp-append-version="true"></script>
    <script src="~/js/gun.js" asp-append-version="true"></script>
}
