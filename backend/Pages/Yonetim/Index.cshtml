@page
@using Kafamdakiler.Eylemler
@using Kafamdakiler.Yonetim
@model Kafamdakiler.Pages.Yonetim.IndexModel
@{
    ViewData["Title"] = "Yönetim";
}

<div class="kd-page-head kd-rise kd-c-violet">
    <div>
        <p class="kd-eyebrow">Asistan, beyin ve gönderim</p>
        <h1 class="kd-page-title">Yönetim</h1>
    </div>
</div>

@if (Model.Hata is not null)
{
    <div class="kd-alert" role="alert">@Model.Hata</div>
}

<section class="kd-yonetim-blok" aria-labelledby="izinler-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="izinler-baslik">Asistan'ın izinleri</h2>
    <p class="kd-muted">Asistan'ın neleri görüp değiştirebileceğini alana göre seç. Değişiklik Asistan'ın bir sonraki isteğinde geçerli olur.</p>

    @foreach (var kart in Model.GrupKartlari)
    {
        <div class="kd-izin">
            <div class="kd-izin-metin">
                <strong>@kart.Grup.Ad</strong>
                <span class="kd-muted">@kart.Grup.Aciklama</span>
                @if (kart.Kip == GrupKipi.Ozel)
                {
                    <span class="kd-muted">Özel: izinler tek tek ayarlanmış (Gelişmiş'te görünür). Aşağıdan birini seçersen düzelir.</span>
                }
            </div>
            <form method="post" asp-page-handler="Grup" class="kd-kip-secenek" role="group" aria-label="@kart.Grup.Ad izni">
                <input type="hidden" name="grup" value="@kart.Grup.Anahtar" />
                @foreach (var (kip, ad) in new[] { (GrupKipi.Kapali, "Kapalı"), (GrupKipi.Okur, "Okur"), (GrupKipi.OkurVeYazar, "Okur ve yazar") })
                {
                    <button type="submit" name="kip" value="@kip" class="btn btn-sm @(kart.Kip == kip ? "btn-primary" : "btn-outline-primary")"
                            aria-pressed="@(kart.Kip == kip ? "true" : "false")">@ad</button>
                }
            </form>
        </div>
    }

    <div class="kd-izin">
        <div class="kd-izin-metin">
            <strong>Asistan Claude'u çağırabilsin</strong>
            <span class="kd-muted">Metinden iş çıkarır, metni özetler ya da maddeler. Hiçbir şey kaydetmez.</span>
        </div>
        <span class="kd-status @(Model.AsistanAcik ? "is-bitti" : "is-birakildi")">@(Model.AsistanAcik ? "Açık" : "Kapalı")</span>
        <form method="post" asp-page-handler="Izin">
            <input type="hidden" name="izin" value="@IzinGruplari.AsistanAnahtari" />
            <input type="hidden" name="acik" value="@((!Model.AsistanAcik).ToString().ToLowerInvariant())" />
            <button type="submit" class="btn @(Model.AsistanAcik ? "btn-outline-primary" : "btn-primary")">@(Model.AsistanAcik ? "Kapat" : "Aç")</button>
        </form>
    </div>
</section>

<section class="kd-yonetim-blok" aria-labelledby="kip-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="kip-baslik">Asistan'ın önerileri</h2>
    <p class="kd-muted">@(Model.EylemKipleri.Count == 0 ? "Eylem türü yok." : Model.EylemOzeti)</p>

    <details>
        <summary>Gelişmiş</summary>

        <h3 class="kd-eyebrow kd-section-title">Tek tek izinler</h3>
        <p class="kd-muted">Yukarıdaki kartların arkasındaki ayrıntılı izinler.</p>
        @foreach (var izin in Model.IzinListesi)
        {
            <div class="kd-izin">
                <div class="kd-izin-metin">
                    <code>@izin.Izin</code>
                    <span class="kd-muted">@izin.Aciklama</span>
                </div>
                <span class="kd-status @(izin.Acik ? "is-bitti" : "is-birakildi")">@(izin.Acik ? "Açık" : "Kapalı")</span>
                <form method="post" asp-page-handler="Izin">
                    <input type="hidden" name="izin" value="@izin.Izin" />
                    <input type="hidden" name="acik" value="@((!izin.Acik).ToString().ToLowerInvariant())" />
                    <button type="submit" class="btn @(izin.Acik ? "btn-outline-primary" : "btn-primary")">@(izin.Acik ? "Kapat" : "Aç")</button>
                </form>
            </div>
        }

        <h3 class="kd-eyebrow kd-section-title">Eylem kipleri</h3>
        <p class="kd-muted">
            Her eylem türü için Asistan'ın ne yapabileceğini seç. Kendin yap seçilse bile başkasının yazdığı metinden çıkan öneriler onay bekler.
        </p>

        @foreach (var k in Model.EylemKipleri)
        {
            <div class="kd-izin">
                <div class="kd-izin-metin">
                    <strong>@k.TurAdi</strong>
                    <span class="kd-muted">@EylemGorunum.KipAciklamasi(k.Kip)</span>
                </div>
                <form method="post" asp-page-handler="EylemKipi" class="kd-kip-secenek" role="group" aria-label="@k.TurAdi kipi">
                    <input type="hidden" name="tur" value="@k.Tur" />
                    @foreach (var kip in Enum.GetValues<EylemKipi>())
                    {
                        <button type="submit" name="kip" value="@kip" class="btn btn-sm @(k.Kip == kip ? "btn-primary" : "btn-outline-primary")"
                                aria-pressed="@(k.Kip == kip ? "true" : "false")">@EylemGorunum.KipAdi(kip)</button>
                    }
                </form>
            </div>
        }
    </details>
</section>

<section class="kd-yonetim-blok" aria-labelledby="oturum-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="oturum-baslik">Asistan'ın oturumları</h2>
    <p class="kd-muted">
        Asistan'ın oturumları kapanır ve yeniden giriş yapması gerekir. Açık kalan oturum en çok 1 saat daha çalışabilir;
        hemen kesmek için izinleri kapat.
    </p>
    <form method="post" asp-page-handler="OturumlariKapat"
          onsubmit="return confirm('Asistan yeniden giriş yapmak zorunda kalacak. Emin misin?');">
        <button type="submit" class="btn btn-outline-primary">Asistan'ın oturumlarını kapat</button>
    </form>
</section>

<section class="kd-yonetim-blok" aria-labelledby="sifre-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="sifre-baslik">Asistan'ın şifresi</h2>
    <p class="kd-muted">
        Eski şifreyi bilmen gerekmez. Kaydedince Asistan'ın oturumları da kapanır; yeni şifreyle yeniden giriş yapması gerekir.
    </p>
    <form method="post" asp-page-handler="AsistanSifre" class="kd-sifre-form" autocomplete="off">
        <div class="kd-field">
            <label class="kd-field-label" asp-for="Sifre.YeniSifre"></label>
            <div class="kd-field-control">
                <input class="form-control" asp-for="Sifre.YeniSifre" autocomplete="new-password" />
                <button type="button" class="kd-field-action" data-kd-password-toggle aria-label="Şifreyi göster">Göster</button>
            </div>
            <span class="kd-field-error" asp-validation-for="Sifre.YeniSifre"></span>
        </div>

        <div class="kd-field">
            <label class="kd-field-label" asp-for="Sifre.YeniSifreTekrar"></label>
            <div class="kd-field-control">
                <input class="form-control" asp-for="Sifre.YeniSifreTekrar" autocomplete="new-password" />
            </div>
            <span class="kd-field-error" asp-validation-for="Sifre.YeniSifreTekrar"></span>
        </div>

        <button type="submit" class="btn btn-outline-primary">Şifreyi yenile</button>
    </form>
</section>

<section class="kd-yonetim-blok" aria-labelledby="beyin-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="beyin-baslik">Beyin</h2>
    <dl class="kd-facts">
        <div>
            <dt>Bağlantı</dt>
            <dd>@(Model.BeyinDurumu.Bagli ? "Bağlı" : "Bağlı değil")</dd>
        </div>
        <div>
            <dt>Vault</dt>
            <dd>@(Model.BeyinDurumu.Vault ?? "-")</dd>
        </div>
        <div>
            <dt>Bekleyen yakalama</dt>
            <dd>@Model.BeyinDurumu.BekleyenYakalama</dd>
        </div>
        <div>
            <dt>İlgi isteyen</dt>
            <dd>@Model.BeyinDurumu.HataliYakalama</dd>
        </div>
    </dl>
</section>

<section class="kd-yonetim-blok" aria-labelledby="google-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="google-baslik">Google Takvim</h2>

    @if (Model.GoogleSonucu is not null)
    {
        <div class="@(Model.GoogleSonucuHata ? "kd-alert" : "kd-gun-uyari")" role="@(Model.GoogleSonucuHata ? "alert" : "status")">@Model.GoogleSonucu</div>
    }

    @{
        var g = Model.GoogleDurumu;
    }
    @if (g.Durum == "kapali")
    {
        <p class="kd-muted">Google Takvim ayarlanmamış; takvim kapalı.</p>
    }
    else if (g.Durum != "bagli")
    {
        @if (g.Durum == "yenidenBaglan")
        {
            <p class="kd-muted">Google bağlantısı koptu.</p>
        }
        <form method="post" asp-page-handler="GoogleBagla">
            <button type="submit" class="btn btn-primary">@(g.Durum == "yenidenBaglan" ? "Yeniden bağla" : "Google Takvim'i bağla")</button>
        </form>
    }
    else
    {
        <dl class="kd-facts">
            <div>
                <dt>Son eşitleme</dt>
                <dd>@(g.SonEsitleme is { } son ? son.ToLocalTime().ToString("dd.MM HH:mm") : "Henüz eşitlenmedi")</dd>
            </div>
            <div>
                <dt>Etkinlik</dt>
                <dd>@g.EtkinlikSayisi</dd>
            </div>
        </dl>
        <div class="kd-gun-actions">
            <form method="post" asp-page-handler="GoogleEsitle">
                <button type="submit" class="btn btn-primary">Şimdi eşitle</button>
            </form>
            <form method="post" asp-page-handler="GoogleKes"
                  onsubmit="return confirm('Bağlantı kesilecek ve eşitlenen etkinlikler silinecek. Emin misin?');">
                <button type="submit" class="btn btn-outline-primary">Bağlantıyı kes</button>
            </form>
        </div>
    }
</section>

<section class="kd-yonetim-blok" aria-labelledby="repo-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="repo-baslik">Proje ↔ depo</h2>
    <p class="kd-muted">Bir proje bir GitHub deposuna bağlanınca proje sayfasında son commit'ler ve açık PR sayısı görünür.</p>

    @foreach (var r in Model.RepoEslemeleri)
    {
        <div class="kd-izin">
            <div class="kd-izin-metin">
                <code>@r.Proje</code>
                <a href="@r.Baglanti" rel="noopener noreferrer" target="_blank">@r.Depo</a>
            </div>
            <form method="post" asp-page-handler="RepoSil">
                <input type="hidden" name="proje" value="@r.Proje" />
                <button type="submit" class="btn btn-outline-primary">Kaldır</button>
            </form>
        </div>
    }

    @if (Model.ProjeListesiHatasi is not null)
    {
        <p class="kd-muted">@Model.ProjeListesiHatasi</p>
    }
    else if (Model.Projeler.Count > 0)
    {
        <form method="post" asp-page-handler="RepoAyarla" class="kd-gun-form">
            <label class="visually-hidden" for="repo-proje">Proje</label>
            <select class="form-select" id="repo-proje" name="proje" required>
                @foreach (var p in Model.Projeler)
                {
                    <option value="@p.Kimlik">@p.Baslik</option>
                }
            </select>
            <label class="visually-hidden" for="repo-depo">Depo</label>
            <input class="form-control" id="repo-depo" name="depo" maxlength="140" placeholder="owner/repo" autocomplete="off" required />
            <button type="submit" class="btn btn-primary">Bağla</button>
        </form>
    }
</section>

<section class="kd-yonetim-blok" aria-labelledby="gonderim-baslik">
    <h2 class="kd-eyebrow kd-section-title" id="gonderim-baslik">Takılı ya da hatalı gönderimler</h2>

    @if (Model.Kuyruk.Count == 0)
    {
        <div class="kd-empty kd-empty--small">
            <p class="kd-empty-title">Takılı gönderim yok.</p>
        </div>
    }
    else
    {
        @foreach (var y in Model.Kuyruk)
        {
            <article class="kd-capture kd-c-violet" id="y-@y.Id">
                <div class="kd-capture-body">
                    <p class="kd-capture-text @(string.IsNullOrEmpty(y.Metin) ? "is-empty" : "")">@(string.IsNullOrEmpty(y.Metin) ? "Fotoğraf" : y.Metin)</p>
                    <p class="kd-capture-meta">
                        <span class="kd-status is-@(y.Gonderim == GonderimDurumu.Takili ? "birakildi" : "hata")">@(y.Gonderim == GonderimDurumu.Takili ? "Takılı" : "Hatalı")</span>
                        <span>@y.DenemeSayisi deneme</span>
                        @if (y.SonDenemeAt is { } son)
                        {
                            <time datetime="@son.ToString("o")">@son.ToLocalTime().ToString("dd.MM HH:mm")</time>
                        }
                    </p>
                    @if (y.SonHata is not null)
                    {
                        <p class="kd-muted kd-yonetim-hata">@y.SonHata</p>
                    }
                    @if (y.Gonderim == GonderimDurumu.Takili)
                    {
                        <p class="kd-muted kd-yonetim-hata">Sonuç belirsiz: kart beyinde olabilir. Yeniden denemeden önce beynin gelen kutusuna bak.</p>
                    }
                </div>
                <form method="post" asp-page-handler="YenidenDene" asp-route-id="@y.Id">
                    <button type="submit" class="btn btn-outline-primary">Yeniden dene</button>
                </form>
            </article>
        }
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
