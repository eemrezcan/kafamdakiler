@inject Kafamdakiler.Eylemler.EylemServisi EylemServisi
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";
    // Which menu entry a page belongs to. The approval queue is reached from the inbox and the day page, so it lights the inbox.
    var bugunAktif = currentPage is "/Index" or "/Beyin/Gun";
    var gelenAktif = currentPage.StartsWith("/Gelen") || currentPage.StartsWith("/Eylemler") || currentPage.StartsWith("/Yakalamalar");
    var projelerAktif = currentPage is "/Beyin/Index" or "/Beyin/Proje";
    var hatirlaticiAktif = currentPage.StartsWith("/Hatirlaticilar");
    var dahaFazlaAktif = currentPage.StartsWith("/Aliskanliklar") || currentPage.StartsWith("/Yonetim") || currentPage.StartsWith("/Isler");
    var araAktif = currentPage is "/Beyin/Ara" or "/Beyin/Not";
    // Signed-out visitors only see the sign-in page, so the app chrome (top bar, settings, footer) is hidden for them.
    var showChrome = User.Identity?.IsAuthenticated == true;
    // The inbox badge: placement suggestions waiting in that queue (counting the cards would start the brain on every page).
    var bekleyenGelen = 0;
    if (showChrome)
    {
        try
        {
            bekleyenGelen = await EylemServisi.BekleyenSayisiAsync(Kafamdakiler.Eylemler.YerlestirTuru.Anahtar, Context.RequestAborted);
        }
        catch (Exception)
        {
        }
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Kafamdakiler</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <link rel="preload" href="~/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script src="~/js/theme/color-mode.js" asp-append-version="true"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kafamdakiler.styles.css" asp-append-version="true" />
</head>
<body class="@(showChrome ? "" : "kd-bare")">
    @if (showChrome)
    {
    <header class="kd-topbar">
        <nav class="kd-topbar-inner container" aria-label="Ana menü">
            <a class="kd-brand" asp-area="" asp-page="/Index">
                <svg class="kd-brand-mark" aria-hidden="true"><use href="/img/icons.svg#brain"></use></svg>
                <span class="kd-brand-name">kafamdakiler</span>
            </a>

            <div class="kd-nav-links">
                <a class="kd-nav-link @(bugunAktif ? "active" : "")" asp-area="" asp-page="/Index">Bugün</a>
                <a class="kd-nav-link @(gelenAktif ? "active" : "")" asp-area="" asp-page="/Gelen/Index">
                    Gelen
                    @if (bekleyenGelen > 0)
                    {
                        <span class="kd-badge" aria-label="@bekleyenGelen bekleyen öneri">@bekleyenGelen</span>
                    }
                </a>
                <a class="kd-nav-link @(projelerAktif ? "active" : "")" asp-area="" asp-page="/Beyin/Index">Projeler</a>
                <a class="kd-nav-link @(hatirlaticiAktif ? "active" : "")" asp-area="" asp-page="/Hatirlaticilar/Index">Hatırlatıcılar</a>
                <div class="dropdown kd-nav-more">
                    <button class="kd-nav-link @(dahaFazlaAktif ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Daha fazla
                        <svg class="kd-icon kd-nav-caret" aria-hidden="true"><use href="/img/icons.svg#lucide-chevron-left"></use></svg>
                    </button>
                    <ul class="dropdown-menu kd-menu kd-menu--simple">
                        <li><a class="dropdown-item @(currentPage.StartsWith("/Aliskanliklar") ? "active" : "")" asp-area="" asp-page="/Aliskanliklar/Index">Alışkanlıklar</a></li>
                        <li><a class="dropdown-item @(currentPage.StartsWith("/Isler") ? "active" : "")" asp-area="" asp-page="/Isler/Index">Asistan işleri</a></li>
                        <li><a class="dropdown-item @(currentPage.StartsWith("/Yonetim") ? "active" : "")" asp-area="" asp-page="/Yonetim/Index">Yönetim</a></li>
                    </ul>
                </div>
            </div>

            <a class="kd-icon-btn kd-search-btn @(araAktif ? "active" : "")" asp-area="" asp-page="/Beyin/Ara" aria-label="Ara" title="Ara">
                <svg class="kd-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            </a>

            <button class="kd-icon-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#kd-settings"
                    aria-controls="kd-settings" aria-label="Ayarlar">
                <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#settings"></use></svg>
            </button>
        </nav>
    </header>

    <aside class="offcanvas offcanvas-end kd-drawer" tabindex="-1" id="kd-settings" aria-labelledby="kd-settings-title">
        <div class="kd-drawer-header">
            <div>
                <p class="kd-eyebrow">Tercihler</p>
                <h2 class="kd-drawer-title" id="kd-settings-title">Ayarlar</h2>
            </div>
            <button type="button" class="kd-icon-btn" data-bs-dismiss="offcanvas" aria-label="Kapat">
                <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#close"></use></svg>
            </button>
        </div>

        <div class="kd-drawer-body">
            <section class="kd-drawer-section" aria-labelledby="kd-account-title">
                <h3 class="kd-eyebrow kd-section-title" id="kd-account-title">Hesap</h3>
                <p class="kd-drawer-account">@User.Identity?.Name</p>
                <a class="btn btn-outline-primary w-100 mb-2" asp-area="" asp-page="/Hesap/Sifre">Şifremi değiştir</a>
                <form method="post" asp-page="/Hesap/Cikis">
                    <button type="submit" class="btn btn-outline-primary w-100">Çıkış yap</button>
                </form>
            </section>

            <section class="kd-drawer-section kd-drawer-pages" aria-labelledby="kd-pages-title">
                <h3 class="kd-eyebrow kd-section-title" id="kd-pages-title">Sayfalar</h3>
                <a class="kd-drawer-link @(bugunAktif ? "active" : "")" asp-area="" asp-page="/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#home"></use></svg>
                    Bugün
                </a>
                <a class="kd-drawer-link @(gelenAktif ? "active" : "")" asp-area="" asp-page="/Gelen/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-check"></use></svg>
                    Gelen
                    @if (bekleyenGelen > 0)
                    {
                        <span class="kd-badge" aria-label="@bekleyenGelen bekleyen öneri">@bekleyenGelen</span>
                    }
                </a>
                <a class="kd-drawer-link @(projelerAktif ? "active" : "")" asp-area="" asp-page="/Beyin/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#brain"></use></svg>
                    Projeler
                </a>
                <a class="kd-drawer-link @(hatirlaticiAktif ? "active" : "")" asp-area="" asp-page="/Hatirlaticilar/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-bell"></use></svg>
                    Hatırlatıcılar
                </a>
                <a class="kd-drawer-link @(currentPage.StartsWith("/Aliskanliklar") ? "active" : "")" asp-area="" asp-page="/Aliskanliklar/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-target"></use></svg>
                    Alışkanlıklar
                </a>
                <a class="kd-drawer-link @(currentPage.StartsWith("/Isler") ? "active" : "")" asp-area="" asp-page="/Isler/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#brain"></use></svg>
                    Asistan işleri
                </a>
                <a class="kd-drawer-link @(currentPage.StartsWith("/Yonetim") ? "active" : "")" asp-area="" asp-page="/Yonetim/Index">
                    <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#settings"></use></svg>
                    Yönetim
                </a>
            </section>

            <section class="kd-drawer-section" aria-labelledby="kd-theme-title">
                <h3 class="kd-eyebrow kd-section-title" id="kd-theme-title">Görünüm</h3>
                <p class="kd-section-hint">Sistem seçiliyken tema, cihazının açık/koyu ayarını izler.</p>

                <div class="kd-theme-options" role="radiogroup" aria-labelledby="kd-theme-title">
                    <label class="kd-theme-option">
                        <input type="radio" name="kd-theme" value="auto" data-kd-theme-value="auto" />
                        <span class="kd-theme-preview kd-theme-preview--auto" aria-hidden="true"></span>
                        <span class="kd-theme-label">
                            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#device"></use></svg>
                            Sistem
                        </span>
                        <span class="kd-theme-note" data-kd-theme-resolved></span>
                    </label>
                    <label class="kd-theme-option">
                        <input type="radio" name="kd-theme" value="light" data-kd-theme-value="light" />
                        <span class="kd-theme-preview kd-theme-preview--light" aria-hidden="true"></span>
                        <span class="kd-theme-label">
                            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#sun"></use></svg>
                            Açık
                        </span>
                    </label>
                    <label class="kd-theme-option">
                        <input type="radio" name="kd-theme" value="dark" data-kd-theme-value="dark" />
                        <span class="kd-theme-preview kd-theme-preview--dark" aria-hidden="true"></span>
                        <span class="kd-theme-label">
                            <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#moon"></use></svg>
                            Koyu
                        </span>
                    </label>
                </div>
            </section>
        </div>
    </aside>
    }

    <main role="main" class="kd-main container">
        @RenderBody()
    </main>

    @* One-time success message set by a page after a save (TempData "Bildirim"); CSS fades it out. *@
    @if (TempData["Bildirim"] is string bildirim)
    {
    <div class="kd-toast" role="status">
        <svg class="kd-icon" aria-hidden="true"><use href="/img/icons.svg#lucide-check"></use></svg>
        @bildirim
    </div>
    }

    @if (showChrome)
    {
    <footer class="kd-footer">
        <div class="container">
            <span>Kafamdakiler</span>
            <span>© 2026</span>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme/synapse.js" asp-append-version="true"></script>
    <script src="~/js/theme/ui.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
