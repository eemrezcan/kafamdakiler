# On the server this file lives outside the git clone, at /srv/kafamdakiler/.env (mode 640, group deploy),
# and app/deploy/.env is a symlink to it. Never commit the filled-in file (K-0012).
# Generate passwords with: openssl rand -base64 24

POSTGRES_DB=kafamdakiler
POSTGRES_USER=kafamdakiler
POSTGRES_PASSWORD=

SAHIP_EMAIL=
SAHIP_PASSWORD=
ASISTAN_EMAIL=
ASISTAN_PASSWORD=

# Uploaded photos and Data Protection keys (mounted at /data; owned by uid 1654, the container user).
VERI_KLASORU=/srv/kafamdakiler/veri

# The brain (K-0023). BEYIN_KLASORU is mounted at /beyin; leave BEYIN_KOMUT and BEYIN_VAULT empty to run without it.
BEYIN_KLASORU=/srv/kafamdakiler/beyin
BEYIN_KOMUT=
BEYIN_VAULT=

# Claude Code's login (Kat 2 karar 7), mounted at /claude; owned by uid 1654, mode 700. Sign in once:
#   docker compose exec api claude
CLAUDE_KLASORU=/srv/kafamdakiler/claude
# The host's Claude Code binary, mounted read only at /usr/local/bin/claude (the image carries none). A real file, not a symlink.
CLAUDE_IKILISI=/usr/local/bin/claude

# Secret files (K-0012), mounted read only at /gizli. Put firebase-adminsdk.json (the Firebase service account key, from the
# Firebase console) here, owned by uid 1654, mode 400. Without it push to the phones is off and the app still runs.
GIZLI_KLASORU=/srv/kafamdakiler/gizli

# Kat 2 integrations; each stays off while empty.
# Claude Code path in the container (/usr/local/bin/claude); set it only after signing in: docker compose exec api claude
CLAUDE_KOMUT=
# Google Calendar OAuth client (Web application). Register GOOGLE_DONUS_ADRESI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DONUS_ADRESI=https://kafamdakiler.tailbf674b.ts.net/google/donus
# GitHub fine-grained token, read-only, only the mapped repositories (contents + pull requests: read).
GITHUB_TOKEN=
# Gmail (read only): mail of the primary inbox is read by Claude and the findings wait in the approval queue; nothing is applied by itself.
# Off until GMAIL_ACIK=true. After turning it on, connect Google again (Yönetim) so the Gmail permission is granted.
GMAIL_ACIK=false
GMAIL_ARALIK_DAKIKA=10
# Comma-separated addresses ("kisi@ornek.com") or whole domains ("ornek.com") that Claude never reads.
GMAIL_ENGELLENEN_GONDERENLER=
# The Claude model of the Gmail scan: sonnet, haiku or opus. Other kinds: Claude__Modeller__<name> in appsettings.json.
CLAUDE_MODEL_GMAIL=sonnet
# The cheap model that sorts a scan's new mail in one call (important or not); only the important ones reach CLAUDE_MODEL_GMAIL.
CLAUDE_MODEL_GMAIL_SEC=haiku
# Daily Claude calls per model (Europe/Istanbul). Sonnet (and any model not listed) takes Claude__GunlukEnCokCagri, 50 by default.
CLAUDE_SINIR_HAIKU=200
CLAUDE_SINIR_OPUS=10

# Read-only clones of the bridged repositories (task evidence for the notification line).
REPO_KLASORU=/srv/repolar
