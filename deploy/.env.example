# Copy to deploy/.env on the server (chmod 600) and fill in. Never commit the filled-in file (K-0012).
# Generate passwords with: openssl rand -base64 24

POSTGRES_DB=kafamdakiler
POSTGRES_USER=kafamdakiler
POSTGRES_PASSWORD=

SAHIP_EMAIL=
SAHIP_PASSWORD=
ASISTAN_EMAIL=
ASISTAN_PASSWORD=

# The brain (K-0023). Leave empty to run without it. BEYIN_KLASORU is the host folder mounted at /beyin.
BEYIN_KLASORU=./beyin
BEYIN_KOMUT=
BEYIN_VAULT=
