# Copy to /srv/kafamdakiler/yedek/restic.env (owner root, mode 600) and fill in. Never commit the filled-in file.
# B2 through its S3-compatible API (the restic docs recommend it over the native b2 backend).
# The endpoint is on the bucket's page in B2, e.g. s3.eu-central-003.backblazeb2.com.
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/kafamdakiler
AWS_ACCESS_KEY_ID=<B2 keyID>
AWS_SECRET_ACCESS_KEY=<B2 applicationKey>
# Encrypts every snapshot. Keep a copy in your password manager: without it the backup cannot be opened.
RESTIC_PASSWORD=
